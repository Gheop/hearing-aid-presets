#!/bin/bash
# Connect LE Audio hearing aids and make sure PipeWire ends up on the BAP
# profile. Meant to run from the hearing-aids-connect user service at session
# start, or by hand.
#
# BlueZ does not renegotiate BAP for aids that were already connected when
# WirePlumber registered its endpoints, and falls back to "asha-sink", which
# does not carry audio on these devices. The recovery is always a reset of
# the adapter, never a disconnect: with BlueZ 5.87 an aid that reconnects on
# its own right after a disconnect regularly ends up connected with no
# profile at all ("No matching connection for device"), silent until
# bluetoothd is restarted.
#
# Configuration: ~/.config/hearing-aids/devices.conf
#   LEFT=AA:BB:CC:DD:EE:FF
#   RIGHT=AA:BB:CC:DD:EE:00
#   LEFT_ALIAS="Vivia"        # optional, shown in GNOME
#   RIGHT_ALIAS="Vivia R"     # optional
#   RESET_ON_BOOT=no          # optional, keep the stale ISO group bug reproducible
#   BUDGET_SECONDS=120        # optional, when to give up instead of retrying

set -u

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/hearing-aids/devices.conf"
if [ ! -r "$CONFIG" ]; then
    echo "Missing $CONFIG (see README, section Configuration)." >&2
    exit 1
fi
# shellcheck source=/dev/null
. "$CONFIG"
: "${LEFT:?LEFT= missing in $CONFIG}"
: "${RIGHT:?RIGHT= missing in $CONFIG}"
LEFT_ALIAS="${LEFT_ALIAS:-}"
RIGHT_ALIAS="${RIGHT_ALIAS:-}"
RESET_AT=""
RESET_ON_BOOT="${RESET_ON_BOOT:-yes}"
STREAM_EARS=0

# Each recovery step costs tens of seconds and the aids are not always
# reachable. Give up on our own terms rather than spending three minutes at
# login; the unit's TimeoutStartSec sits well above this, so systemd never
# interrupts a reset. BUDGET_SECONDS is overridable for a manual run.
BUDGET_SECONDS="${BUDGET_SECONDS:-120}"
DEADLINE=$(( $(date +%s) + BUDGET_SECONDS ))
out_of_time() { [ "$(date +%s)" -ge "$DEADLINE" ]; }
give_up_if_late() {
    out_of_time || return 0
    echo "Giving up after ${BUDGET_SECONDS}s rather than starting another recovery step." >&2
    echo "Run connect-hearing-aids again, or see the Troubleshooting section of the README." >&2
    exit 1
}

# The adapter is powered off for a moment during a reset. Anything that stops
# the script in that window (systemd's start timeout, Ctrl+C, the session
# ending) would leave Bluetooth off, keyboard and mouse included, until
# someone turns it back on by hand.
ADAPTER_OFF=0
# shellcheck disable=SC2317,SC2329  # reached through wait_for or a trap
restore_adapter() {
    [ "$ADAPTER_OFF" = 1 ] || return 0
    ADAPTER_OFF=0
    echo "Interrupted while the adapter was off: powering it back on." >&2
    bluetoothctl power on > /dev/null 2>&1
}
trap 'restore_adapter; exit 1' INT TERM
trap restore_adapter EXIT

# D-Bus path of a device, whatever adapter it is paired with.
device_path() {
    busctl tree org.bluez --list 2>/dev/null | grep -m1 "/dev_${1//:/_}\$"
}

set_alias() {
    local mac="$1" name="$2" path
    [ -n "$name" ] || return 0
    path="$(device_path "$mac")"
    [ -n "$path" ] || return 0
    busctl call org.bluez "$path" org.freedesktop.DBus.Properties Set ssv \
        org.bluez.Device1 Alias s "$name" 2>/dev/null
}

is_connected() {
    bluetoothctl info "$1" 2>/dev/null | grep -q "Connected: yes"
}

# shellcheck disable=SC2317,SC2329  # reached through wait_for or a trap
active_profile() {
    local card="bluez_card.${1//:/_}"
    LC_ALL=C pactl list cards 2>/dev/null | awk -v card="$card" '
        $1 == "Name:" { current = $2 }
        current == card && /Active Profile:/ { print $NF; exit }'
}

connect_device() {
    local mac="$1" alias="$2"
    local label="${alias:-$mac}"

    set_alias "$mac" "$alias"

    if is_connected "$mac"; then
        echo "  $label: already connected"
        return 0
    fi

    echo "  $label: connecting..."
    # The first attempt right after a bluetoothd restart often fails with
    # le-connection-abort-by-local; the second one goes through.
    for _ in 1 2; do
        out_of_time && break
        if timeout 40 bluetoothctl connect "$mac" > /dev/null 2>&1; then
            echo "  $label: connected"
            return 0
        fi
        sleep 3
    done
    echo "  $label: failed"
    return 1
}

# wait_for <function> <seconds>: poll once a second until it succeeds.
wait_for() {
    local check="$1" tries="$2"
    while [ "$tries" -gt 0 ]; do
        "$check" && return 0
        sleep 1
        tries=$((tries - 1))
    done
    return 1
}

# True once WirePlumber has registered its LE Audio endpoints with BlueZ:
# the adapter's Media1.SupportedUUIDs then lists the Sink PAC UUID (0x2BC9).
# Connecting before that only yields the ASHA profile.
# shellcheck disable=SC2317,SC2329  # reached through wait_for or a trap
bap_endpoints_ready() {
    local adapter
    adapter="$(busctl tree org.bluez --list 2>/dev/null | grep -m1 -E '/org/bluez/hci[0-9]+$')"
    [ -n "$adapter" ] || return 1
    busctl get-property org.bluez "$adapter" org.bluez.Media1 SupportedUUIDs 2>/dev/null |
        grep -qi 00002bc9
}

# True when at least one aid is connected and every connected one sits on the
# bap-sink profile. Without the count, an empty loop used to report success
# with both aids in the charger, and the script then reset the adapter twice
# for nothing.
# shellcheck disable=SC2317,SC2329  # reached through wait_for or a trap
bap_ok() {
    local mac n=0
    for mac in "$RIGHT" "$LEFT"; do
        is_connected "$mac" || continue
        [ "$(active_profile "$mac")" = "bap-sink" ] || return 1
        n=$((n + 1))
    done
    [ "$n" -gt 0 ]
}

connect_both() {
    connect_device "$RIGHT" "$RIGHT_ALIAS"
    connect_device "$LEFT" "$LEFT_ALIAS"
}

# Number of PipeWire sinks belonging to the pair. One means the coordinated
# set formed; two means each aid got its own set, and their two ISO groups
# then block each other in the controller ("Device or resource busy").
pair_sinks() {
    pactl list sinks short 2>/dev/null | grep -cE "bluez_output\.(${RIGHT//:/_}|${LEFT//:/_})\."
}

# The stream probe reads the system journal; without access to it, no error
# would ever be seen and the probe would always pass.
if ! journalctl -u bluetooth -n 1 --quiet > /dev/null 2>&1; then
    echo "Cannot read the system journal (add yourself to the systemd-journal group): the stream check is disabled." >&2
    JOURNAL_OK=0
else
    JOURNAL_OK=1
fi

# True when every BAP transport of the pair reports State=active, which is
# what an established ISO stream looks like from D-Bus. An Acquire refused by
# BlueZ leaves no journal line, so this is the check that catches it.
# shellcheck disable=SC2317,SC2329  # reached through wait_for or a trap
transports_active() {
    local path state n=0 pattern
    pattern="/dev_(${RIGHT//:/_}|${LEFT//:/_})/pac_sink[0-9]+/fd[0-9]+\$"
    STREAM_EARS=0
    for path in $(busctl tree org.bluez --list 2>/dev/null | grep -E "$pattern"); do
        state="$(busctl get-property org.bluez "$path" org.bluez.MediaTransport1 State 2>/dev/null)"
        [ "$state" = 's "active"' ] || return 1
        n=$((n + 1))
    done
    STREAM_EARS="$n"
    [ "$n" -gt 0 ]
}

# Say how many ears actually carry the stream: one silent aid used to be
# reported as a full success.
ears_note() {
    case "$STREAM_EARS" in
        2) echo "both aids" ;;
        1) echo "one aid only, the other is not streaming" ;;
        *) echo "$STREAM_EARS aids" ;;
    esac
}

# Play a few seconds of silence, check that the transports go active, and
# look for ISO connection failures in the bluetoothd journal. A stale ISO
# group in the controller survives reconnects and even a bluetoothd restart;
# only powering the adapter off and on clears it. The journal part is
# inconclusive (passes) when the journal is not readable.
stream_ok() {
    local sink since
    sink="$(pactl list sinks short 2>/dev/null | grep -E "bluez_output\.(${RIGHT//:/_}|${LEFT//:/_})\." | head -1 | awk '{print $2}')"
    [ -n "$sink" ] || return 1
    # When something is already playing, bluetoothd retries the ISO connect
    # every 30 s: a failure from the last cycle counts too, but nothing from
    # before the last adapter reset does.
    since="$(date -d '-35 seconds' '+%Y-%m-%d %H:%M:%S')"
    if [ -n "$RESET_AT" ] && [ "$RESET_AT" \> "$since" ]; then
        since="$RESET_AT"
    fi
    timeout 6 pw-play --raw --format=s16 --rate=48000 --channels=2 --target="$sink" /dev/zero > /dev/null 2>&1 &
    sleep 4
    if ! transports_active; then
        kill %% 2>/dev/null; wait 2>/dev/null
        echo "  transports not active during playback"
        return 1
    fi
    kill %% 2>/dev/null
    wait 2>/dev/null
    [ "$JOURNAL_OK" = 1 ] || return 0
    ! journalctl -u bluetooth --since "$since" --no-pager 2>/dev/null | grep -qE 'iso_connect_cb.*(busy|timed out)'
}

# shellcheck disable=SC2317,SC2329  # reached through wait_for or a trap
adapter_off() { bluetoothctl show 2>/dev/null | grep -q 'Powered: no'; }
# shellcheck disable=SC2317,SC2329  # reached through wait_for or a trap
adapter_on() { bluetoothctl show 2>/dev/null | grep -q 'Powered: yes'; }
# shellcheck disable=SC2317,SC2329  # reached through wait_for or a trap
both_connected() { is_connected "$LEFT" && is_connected "$RIGHT"; }

power_cycle() {
    echo "Resetting the Bluetooth adapter..."
    ADAPTER_OFF=1
    bluetoothctl power off > /dev/null 2>&1
    wait_for adapter_off 5 || true
    RESET_AT="$(date '+%Y-%m-%d %H:%M:%S')"
    bluetoothctl power on > /dev/null 2>&1
    ADAPTER_OFF=0
    wait_for adapter_on 5 || true
    # Trusted aids reconnect on their own right after power on; a connect
    # issued during that reconnection fails, so give them a moment first.
    wait_for both_connected 6 || true
    connect_both
    wait_for bap_ok 15 || true
}

# Trusted aids reconnect the moment bluetoothd starts, long before the user
# session's WirePlumber exists. That first connection leaves an ISO group in
# the controller that no disconnect clears, and the first stream after login
# fails with "Device or resource busy". Resetting the adapter once per boot,
# before connecting, makes the aids connect with WirePlumber already there.
BOOT_STAMP="${XDG_CACHE_HOME:-$HOME/.cache}/hearing-aids/boot_id"
first_run_since_boot() {
    local boot_id
    boot_id="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)" || return 1
    [ "$(cat "$BOOT_STAMP" 2>/dev/null)" != "$boot_id" ]
}

# Only once the reset has actually run: a script killed in the middle of one
# must still reset on the next run.
mark_boot_done() {
    local boot_id
    boot_id="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)" || return 0
    mkdir -p "$(dirname "$BOOT_STAMP")" && echo "$boot_id" > "$BOOT_STAMP"
}

echo "Waiting for WirePlumber's LE Audio endpoints..."
if ! wait_for bap_endpoints_ready 20; then
    echo "No LE Audio endpoint registered after 20 s: is WirePlumber running with Bluetooth support?" >&2
fi

if [ "$RESET_ON_BOOT" != no ] && first_run_since_boot; then
    echo "First run since boot: resetting the adapter so the aids connect after WirePlumber..."
    power_cycle
    mark_boot_done
else
    echo "Connecting hearing aids..."
    connect_both
fi

if ! is_connected "$LEFT" && ! is_connected "$RIGHT"; then
    echo "Neither aid is connected. They are probably in their charger, out of" >&2
    echo "range, or connected to your phone (aids accept a single central)." >&2
    exit 1
fi

finish() {
    if [ "$(pair_sinks)" -gt 1 ]; then
        echo "The pair shows up as two sinks instead of one coordinated set."
        give_up_if_late
        power_cycle
    fi
    if stream_ok; then
        echo "BAP profile active, stream established ($(ears_note))."
        exit 0
    fi
    echo "ISO stream failed (busy or timed out)."
    give_up_if_late
    power_cycle
    if stream_ok; then
        echo "BAP profile active, stream established after adapter reset ($(ears_note))."
        exit 0
    fi
    echo "Stream still failing after an adapter reset. Try a reboot, and check docs/ for known issues." >&2
    exit 1
}

# WirePlumber needs a few seconds after the connection to switch profiles.
if wait_for bap_ok 12; then
    echo "BAP profile active."
    finish
fi

# BlueZ 5.87 sometimes answers "No matching connection for device" when an
# aid reconnects on its own right after a disconnect, and then attaches no
# profile to it at all; only restarting bluetoothd clears that. A power cycle
# of the adapter reconnects both aids together and has never produced it.
give_up_if_late
echo "No BAP profile: resetting the adapter so both aids reconnect together..."
power_cycle
if bap_ok; then
    echo "BAP profile active."
    finish
fi
# Last resort: restart bluetoothd (allowed without a password when the polkit
# rule from bluetooth/50-hearing-aids-bluetooth.rules is installed), then
# WirePlumber, which otherwise keeps stale nodes from before the restart.
echo "Still no BAP profile after an adapter reset: bluetoothd is probably holding a stale connection."
give_up_if_late
if systemctl --no-ask-password restart bluetooth.service 2>/dev/null; then
    echo "Restarted bluetoothd and WirePlumber, connecting again..."
    timeout 20 systemctl --user restart wireplumber.service ||
        echo "  restarting WirePlumber failed or timed out" >&2
    wait_for bap_endpoints_ready 20 || true
    wait_for both_connected 10 || true
    connect_both
    if wait_for bap_ok 15; then
        echo "BAP profile active."
        finish
    fi
    echo "Still no BAP profile after restarting bluetoothd. Try a reboot, and check docs/ for known issues." >&2
    exit 1
fi
echo "Run: sudo systemctl restart bluetooth && systemctl --user restart wireplumber, then this script again." >&2
echo "(Install bluetooth/50-hearing-aids-bluetooth.rules to let this script do it by itself.)" >&2
exit 1
